# Caddyfile untuk Finance Accounting App (akses via IP / HTTP)
#
# Untuk HTTPS dengan Let's Encrypt, ganti :80 dengan domain Anda
# (mis. akuntansi.example.com) dan set DNS A record ke IP VPS.
# Caddy otomatis menerbitkan dan memperbarui sertifikat.

:80 {
	encode gzip

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:80
	}
}
