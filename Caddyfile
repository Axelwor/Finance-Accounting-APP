# Caddyfile for Finance Accounting App
# Cloudflare proxy mode: Cloudflare handles public SSL.
# Caddy serves HTTP on :80 (for Cloudflare Flexible mode)
# and HTTPS on :443 with Let's Encrypt (for Cloudflare Full mode).
#
# IMPORTANT: Cloudflare SSL mode must be set to "Full" (not Flexible)
# in Cloudflare dashboard → SSL/TLS → Overview.
# With "Full", Cloudflare connects to origin on port 443 and accepts
# any valid cert (including Let's Encrypt).

accounting.tikuma.net {
	encode gzip

	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		# Cache static assets, never cache API responses
		?Cache-Control "no-store"
	}

	handle /healthz* {
		reverse_proxy api:8080
	}
	handle /api/* {
		reverse_proxy api:8080
	}
	handle {
		header ?Cache-Control "public, max-age=3600"
		reverse_proxy web:80
	}
}

# HTTP fallback (no redirect — Cloudflare needs plain HTTP for Flexible mode)
:80 {
	encode gzip
	handle /healthz* {
		reverse_proxy api:8080
	}
	handle /api/* {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy web:80
	}
}
