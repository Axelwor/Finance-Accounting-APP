# Caddyfile untuk Finance Accounting App
# Compatible with Cloudflare proxy (any SSL mode).
# Caddy serves both HTTP (:80) and HTTPS (:443).
# Cloudflare terminates SSL and forwards to port 80 or 443.

:80, :443 {
	encode gzip

	handle /healthz {
		reverse_proxy api:8080
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:80
	}
}
