# Caddyfile untuk Finance Accounting App
# Cloudflare proxy mode (Flexible SSL): Caddy serves HTTP only on :80,
# Cloudflare terminates TLS and forwards to port 80.

:80 {
	encode gzip

	handle /healthz {
		reverse_proxy api:8080
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:80
	}
}
